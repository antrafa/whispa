{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Whispa",
  "version": "0.1.4",
  "identifier": "com.antonioortega.whispa",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "setup",
        "title": "whispa — configurar atalho",
        "width": 560,
        "height": 680,
        "minWidth": 560,
        "maxWidth": 560,
        "minHeight": 480,
        "maxHeight": 1200,
        "resizable": true,
        "visible": false
      },
      {
        "label": "about",
        "title": "whispa — sobre",
        "url": "about.html",
        "width": 400,
        "height": 420,
        "resizable": false,
        "visible": false
      },
      {
        "label": "hud",
        "title": "whispa",
        "url": "hud.html",
        "width": 300,
        "height": 92,
        "resizable": false,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "focus": false,
        "closable": false,
        "minimizable": false,
        "maximizable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNGNDVGQzRFQjExRDY2RTQKUldUa1poMnhUdnhGUDgzRWZadmsyTEhVbTVBRVZXWWpuZkF1WHRBa3VQZWFlNXJNN05JRjE5OGwK",
      "endpoints": [
        "https://github.com/antrafa/whispa/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "publisher": "Antonio Rafael Ortega",
    "copyright": "Copyright © 2026 Antonio Rafael Ortega",
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
